# Browser-side (bundled into the app by Vite)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# Server-side only, used by `npm run db:apply`. Never prefix with VITE_.
# Supabase dashboard → Connect → "Session pooler"
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
