# its hash, and this repo is public). The template without it stays tracked.
seb/web-eval-exam.seb

# Build output
dist/
dist-ssr/
build/

# Vite / bundler cache
.vite/
.turbo/
*.local

# TypeScript
*.tsbuildinfo

# Environment files — any variant with secrets stays out
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# Claude Code personal settings (the shared .claude/launch.json stays tracked)
.claude/settings.local.json

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db
ehthumbs.db

